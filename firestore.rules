rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function okLoc() {
      let d = request.resource.data;
      return d.lat is number && d.lng is number
        && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180
        && d.t is number;
    }
    match /vendors/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && okLoc()
        && request.resource.data.n is string && request.resource.data.n.size() <= 30
        && request.resource.data.c is string && request.resource.data.c.size() <= 24
        && request.resource.data.st in ['jalan','henti','istirahat']
        && request.resource.data.on is bool
        && request.resource.data.ic is string && request.resource.data.ic.size() <= 10
        && request.resource.data.path is list && request.resource.data.path.size() <= 400
        && request.resource.data.ts is number;
    }
    match /calls/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.to == request.auth.uid);
      allow create, update: if request.auth != null && (
        (request.auth.uid == uid && okLoc()
          && request.resource.data.to is string
          && request.resource.data.n is string && request.resource.data.n.size() <= 30
          && request.resource.data.vn is string && request.resource.data.vn.size() <= 30
          && request.resource.data.s == 'minta' && request.resource.data.cx == '')
        || (resource != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s','cx'])
          && ((resource.data.s == 'minta' && request.resource.data.s == 'batal')
            || (resource.data.s == 'terima' && request.resource.data.s in ['terima','batal'])))
        || (resource != null && resource.data.to == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s','cx'])
          && resource.data.s in ['minta','terima']
          && request.resource.data.s in ['terima','tolak','batal']));
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role in ['pembeli','pedagang']
        && request.resource.data.n is string && request.resource.data.n.size() <= 30
        && request.resource.data.t is number;
    }
  }
}
